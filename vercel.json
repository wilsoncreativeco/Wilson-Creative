{
  "rewrites": [
    { "source": "/start",      "destination": "/start.html"    },
    { "source": "/watch",      "destination": "/watch.html"    },
    { "source": "/brief",      "destination": "/brief.html"    },
    { "source": "/finalise",   "destination": "/finalise.html" },
    { "source": "/api/:path*", "destination": "/api/:path*"    },
    { "source": "/content/:path*", "destination": "https://wilson-social-studio.vercel.app/content/:path*" },
    { "source": "/content",    "destination": "https://wilson-social-studio.vercel.app/content" },
    { "source": "/((?!assets|favicon|images|api|start|watch|brief|finalise|content).*)", "destination": "/index.html" }
  ]
}
