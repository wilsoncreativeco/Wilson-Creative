{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/start",      "destination": "/start.html"    },
    { "source": "/watch",      "destination": "/watch.html"    },
    { "source": "/brief",      "destination": "/brief.html"    },
    { "source": "/finalise",   "destination": "/finalise.html" },
    { "source": "/api/:path*", "destination": "/api/:path*"    }
  ]
}
